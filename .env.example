# Copy to .env and fill in real values. .env is gitignored; this file is committed.

# --- OpenRouter ---
# Get a key at https://openrouter.ai/keys. Backend only: never give it a NEXT_PUBLIC_ prefix.
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# --- Postgres ---
POSTGRES_USER=pawdesk
POSTGRES_PASSWORD=pawdesk-local-dev
POSTGRES_DB=pawdesk

# Used when running backend code on your machine (pytest, scripts).
# Inside Docker, docker-compose.yml overrides the host to `postgres`.
DATABASE_URL=postgresql://pawdesk:pawdesk-local-dev@localhost:5432/pawdesk
